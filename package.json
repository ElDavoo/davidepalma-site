{
  "name": "davidepalma-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static, zero-client-JavaScript replacement for the WikiJS site at www.davidepalma.it",
  "scripts": {
    "build": "eleventy",
    "dev": "eleventy --serve",
    "export": "node tools/export-wikijs.mjs --out export",
    "parity": "node tools/parity-check.mjs"
  },
  "dependencies": {
    "@11ty/eleventy": "3.1.2",
    "cheerio": "1.0.0-rc.5",
    "gray-matter": "4.0.3",
    "highlight.js": "10.3.1",
    "katex": "0.12.0",
    "lodash": "4.17.21",
    "markdown-it": "11.0.1",
    "markdown-it-abbr": "1.0.4",
    "markdown-it-attrs": "3.0.3",
    "markdown-it-decorate": "1.2.2",
    "markdown-it-emoji": "3.0.0",
    "markdown-it-expand-tabs": "1.0.13",
    "markdown-it-footnote": "3.0.3",
    "markdown-it-imsize": "2.0.1",
    "markdown-it-sub": "1.0.0",
    "markdown-it-sup": "1.0.0",
    "markdown-it-task-lists": "2.1.1",
    "twemoji": "14.0.2",
    "uslug": "1.0.4"
  }
}
